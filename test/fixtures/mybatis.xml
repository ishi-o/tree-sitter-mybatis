<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- A commented-out statement must remain a comment. -->
<mapper namespace='UserMapper'>
  <sql id="baseColumns">id, name, status</sql>
  <select id='findById' resultType="User"> SELECT <include refid='baseColumns' /> FROM users <where>
      <if test='id != null'>AND id = #{id}</if>
    </where>
  </select>
  <!-- <select id="ignored">SELECT ignored</select> -->
  <insert id="insertUser">
    <![CDATA[INSERT INTO users (name) VALUES (#{name})]]>
  </insert>
  <sql id="test">
   INSERT INTO users ( a,b,c) VALUES (1, 2)
  </sql>
  <select id="parameterStyles" resultType="User">
    SELECT id as a FROM users WHERE id = #{id.abc} AND name = #{name} AND owner = #{user.name} AND table_name = ${table}
  </select>
  <select id="cdataParameter" resultType="User">
    <![CDATA[SELECT * FROM users WHERE id = #{id}]]>
  </select>
</mapper>
