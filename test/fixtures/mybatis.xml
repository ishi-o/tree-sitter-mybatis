<?xml version="1.0" encoding="UTF-8"?>
<!-- A commented-out statement must remain a comment. -->
<mapper namespace='UserMapper'>
  <sql id="baseColumns">id, name, status</sql>
  <select id='findById' resultType="User"> SELECT <include refid='baseColumns' /> FROM users <where>
      <if test='id != null'>AND id = #{id}</if>
    </where>
  </select>
  <!-- <select id="ignored">SELECT ignored</select> -->
  <insert id="insertUser">
    <![CDATA[INSERT INTO users (name) VALUES (#{name})]]>
  </insert>
</mapper>
