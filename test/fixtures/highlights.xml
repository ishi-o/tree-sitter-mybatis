<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.HighlightMapper">
  <sql id="insertFragment">
    INSERT INTO users (id, name) VALUES (#{id}, ${name})
  </sql>
  <select id="parameters" resultType="com.example.User">
    SELECT * FROM users WHERE id = #{id} AND name = #{name} AND owner = #{user.name}
  </select>
  <select id="cdata" resultType="com.example.User">
    <![CDATA[SELECT * FROM users WHERE id = #{id}]]>
  </select>
</mapper>
